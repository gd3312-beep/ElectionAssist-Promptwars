# ElectionAssist — Environment Variables
# Copy this file to .env and fill in your keys

# Google Gemini API Key (required for AI chat)
# Get one at: https://aistudio.google.com/
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Google Maps Embed API Key (required for polling booth map)
# Get one at: https://console.cloud.google.com/google/maps-apis/
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google OAuth Client ID (required for Google Sign-In)
# Get one at: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
